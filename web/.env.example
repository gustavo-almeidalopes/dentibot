# Alvo do proxy /api no dev server do Vite. 8080 é a porta do Spring Boot.
VITE_API_URL=http://localhost:8080

# Chave publicável do Clerk, do dashboard do projeto. O @clerk/react a lê
# sozinho do VITE_ — não é passada ao <ClerkProvider> em main.jsx. Sem ela a
# landing carrega normalmente, mas o widget de /login não monta.
# É pública por definição (o segredo é a secret key, que fica no back-end).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_troque-pela-sua

# Só em produção, e só se o back-end estiver em outro domínio.
# Precisa incluir o prefixo /api. Vazio = usa /api do mesmo host.
# VITE_API_BASE=https://api.dentibot.com.br/api
