# Alvo do proxy /api no dev server do Vite. 8080 é a porta do Spring Boot.
VITE_API_URL=http://localhost:8080

# Só em produção, e só se o back-end estiver em outro domínio.
# Precisa incluir o prefixo /api. Vazio = usa /api do mesmo host.
# VITE_API_BASE=https://api.dentibot.com.br/api

# Chave pública do Clerk. O ClerkProvider não recebe publishableKey por prop:
# o @clerk/react cai em import.meta.env.VITE_CLERK_PUBLISHABLE_KEY. O Vite
# resolve isso no build, então a variável precisa existir em quem compila —
# na Vercel, em Settings > Environment Variables, não só na máquina local.
# Sem ela a landing ainda sobe, mas /login e /clientes ficam sem o widget.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_troque-pela-sua-chave
