# Alvo do proxy /api no dev server do Vite. 8080 é a porta do Spring Boot.
VITE_API_URL=http://localhost:8080

# Só em produção, e só se o back-end estiver em outro domínio — na Vercel,
# sempre. Precisa incluir o prefixo /api/v1. Vazio = usa /api/v1 do mesmo host.
# VITE_API_BASE=https://api.dentibot.com.br/api/v1

# Obrigatória: o ClerkProvider lê essa chave no build. Sem ela o bundle sobe
# mas a página fica em branco — precisa estar setada também na Vercel.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
