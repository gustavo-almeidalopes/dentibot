# Base da API. EXPO_PUBLIC_* é embutido no bundle — portanto NADA de segredo
# aqui. É uma URL pública; a autorização vem do token, não da URL.
#
# Emulador Android: 10.0.2.2 é o host da máquina visto de dentro do emulador.
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
# Simulador iOS: localhost funciona.
#   EXPO_PUBLIC_API_URL=http://localhost:8080
# Aparelho físico na mesma rede: use o IP da máquina.
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
